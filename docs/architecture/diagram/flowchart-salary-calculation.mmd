flowchart TD

    %% ── Entrées persistées ───────────────────────────────────────
    subgraph CONTRACT["📥 SalaryContract — données persistées"]
        I1["annualGrossSalary\n(ou revision active si date ≤ today)"]
        I2["paidMonthsPerYear"]
        I3["weeklyHours"]
        I4["isCadre"]
        I5["employeePrevoyanceRate\n(taux prévoyance salarié, optionnel)"]
        I6["mealVoucherAmount\nmealVoucherEmployeeRate"]
    end

    subgraph EXTRAS["📎 Éléments rattachés"]
        E1["ContractOnCall[]\nforfait hebdo × semaines/an"]
        E2["ContractBenefit[]\nmontants mensuels (exonérés fiscalement)"]
        E3["ContractBonus[]\nprimes (EXCEPTIONNELLE ou ANNUELLE)"]
    end

    subgraph PROFILE["🧾 Profil fiscal — User"]
        F1["fiscalParts"]
        F2["useFlatRateDeduction\n(abattement 10 % ou frais réels)"]
        F3["customProfessionalDeduction\n(calculé par ProfileService)"]
    end

    %% ── Calculs intermédiaires ───────────────────────────────────
    subgraph INTER["⚙️ Calculs intermédiaires"]
        C1["superGross annuel\n= annualGrossSalary × 1.45\n(coût employeur estimé — taux externalisé)"]
        C2["taux charges salariales\n≈ 22 % non-cadre · ≈ 25 % cadre\n+ employeePrevoyanceRate"]
        C3["annualNetImposable\n= annualGrossSalary × (1 − taux charges)"]
        C4["annualWorkingHours\n= weeklyHours × 45.6\n(228 jours ouvrés ÷ 5)"]
        C5["monthlyOnCall\n= Σ (weeklyFlatRate × estimatedWeeksPerYear) ÷ 12"]
        C6["monthlyBenefits\n= Σ ContractBenefit.monthlyAmount"]
        C7["monthlyEstimatedTax\n= TaxSimulatorService.estimerImpotSurSalaire()\n  ÷ paidMonthsPerYear\n⚠ null si fiscalParts absent"]
    end

    %% ── Résultats SalaryContractDto ──────────────────────────────
    subgraph OUTPUT["📊 SalaryContractDto — projections (calculées à la volée)"]

        subgraph GROSS["Super brut / Brut"]
            O1["annualSuperGross\nmonthlySuperGross = ÷ paidMonthsPerYear\ndailySuperGross = ÷ 228\nhourlySuperGross = ÷ annualWorkingHours"]
            O2["baseGrossSalary = annualGrossSalary ÷ paidMonthsPerYear\nmonthlyGrossSalary = baseGrossSalary + monthlyOnCall"]
        end

        subgraph IMPOSABLE["Net imposable"]
            O3["annualNetImposable\nmonthlyNetImposable = ÷ paidMonthsPerYear\ndailyNetImposable = ÷ 228\nhourlyNetImposable = ÷ annualWorkingHours"]
        end

        subgraph AFTERTAX["Net d'impôt"]
            O4["monthlyNetAfterTax\n= monthlyNetImposable − monthlyEstimatedTax\n  + monthlyBenefits\n(avantages ajoutés car exonérés fiscalement)\n⚠ null si profil fiscal incomplet"]
            O5["annualNetAfterTax = monthlyNetAfterTax × paidMonthsPerYear\ndailyNetAfterTax = ÷ 228\nhourlyNetAfterTax = ÷ annualWorkingHours"]
        end

        subgraph TR["Ticket restaurant"]
            O6["employeeMonthlyMealVoucherCost\n= montant × tauxSalarié × 19j\nemployerMonthlyMealVoucherCost\n= montant × (1 − tauxSalarié) × 19j"]
        end

    end

    %% ── Flux ──────────────────────────────────────────────────────
    I1 --> C1
    I1 --> C3
    I4 --> C2
    I5 --> C2
    I2 --> O2
    I3 --> C4
    I6 --> O6

    E1 --> C5
    E2 --> C6
    C5 --> O2

    C2 --> C3
    C3 --> O3
    C4 --> O1
    C4 --> O3
    C4 --> O4
    C1 --> O1

    F1 --> C7
    F2 --> C7
    F3 --> C7
    C7 --> O4
    C6 --> O4
    O3 --> O4
    O4 --> O5
