    %% ══════════════════════════════════════════════════════════════
    %% Relations
    %% ══════════════════════════════════════════════════════════════

    %% Utilisateurs & Groupes
    User --> RoleEnum : role
    User --> SafetyNetMode : safetyNetMode
    User "0..*" --> "0..1" FamilyGroup : appartient à
    FamilyGroup "1" --> "1" User : owner
    FamilyGroupInvitation --> FamilyGroup : group
    FamilyGroupInvitation --> User : invitedUser
    FamilyGroupInvitation --> InvitationStatus : status
    LoginEvent --> LoginEventType : eventType
    UserRegistrationRequest --> RegistrationStatus : status

    %% Revenus salariaux
    User "1" o-- "0..*" SalaryContract : salaryContracts
    SalaryContract "1" o-- "0..*" SalaryRevision : revisions
    SalaryContract "1" o-- "0..*" MonthlyPaySlip : paySlips
    SalaryContract "1" o-- "0..*" ContractBonus : bonuses
    SalaryContract "1" o-- "0..*" ContractBenefit : benefits
    SalaryContract "1" o-- "0..*" ContractOnCall : onCalls
    ContractBonus --> BonusTypeEnum : type
    SalaryContract ..> SalaryContractDto : calcule
    User ..> TaxSimulationDto : simule

    %% Revenus complémentaires
    User "1" o-- "0..*" OtherIncome : otherIncomes
    OtherIncome --> OtherIncomeTypeEnum : type
    OtherIncome "0..*" --> "0..1" Position : position (LOCATIF)

    %% Salaire — type contrat
    SalaryContract --> ContractTypeEnum : contractType
    SalaryContract --> PublicSubTypeEnum : publicSubType

    %% Instruments
    Instrument --> AssetCategory : category
    Instrument --> CryptoType : cryptoType
    Instrument --> CryptoNetwork : cryptoNetwork
    Instrument "1" o-- "0..*" InstrumentAllocation : allocations
    Instrument "1" o-- "0..*" InstrumentSectorAllocation : sectorAllocations

    %% Positions
    User "1" o-- "0..*" Position : positions
    Position --> AssetCategory : category
    Position --> FiscalEnvelope : fiscalEnvelope
    Position --> AssetSubType : assetSubType
    Position --> OwnershipType : ownershipType
    Position --> PropertyUsage : propertyUsage
    Position --> PositionStatus : status
    Position "0..*" --> "0..1" Instrument : instrument
    Position "1" o-- "0..*" PositionOrder : orders
    PositionOrder --> OrderType : orderType

    %% Snapshots
    User "1" o-- "0..*" PortfolioSnapshot : snapshots
    PortfolioSnapshot "1" o-- "0..*" PositionSnapshot : positionSnapshots
    PositionSnapshot --> Position : position

    %% Passifs
    User "1" o-- "0..*" Possession : possessions
    Possession --> PossessionCategoryEnum : category
    User "1" o-- "0..*" Debt : debts
    Debt --> DebtTypeEnum : type
    Debt "1" o-- "0..*" DebtBalanceEntry : balanceEntries

    %% Dépenses & Budgets
    User "1" o-- "0..*" RecurringExpense : recurringExpenses
    RecurringExpense --> ExpenseCategoryEnum : category
    RecurringExpense --> FrequencyEnum : frequency
    User "1" o-- "0..*" UserBudget : budgets
    UserBudget --> ExpenseCategoryEnum : category

    %% Objectifs
    User "1" o-- "0..*" PatrimoineTarget : targets
    PatrimoineTarget "1" o-- "0..*" PatrimoineTargetBreakdown : breakdowns
    PatrimoineTargetBreakdown --> BreakdownDimension : dimension
    User "1" o-- "0..*" PatrimoineKpiTarget : kpiTargets
    PatrimoineKpiTarget --> KpiType : kpiType

    %% Analytics
    User "0..1" o-- "0..*" AnalyticsEvent : events
    User "0..1" o-- "0..*" ErrorLog : errors
    AnalyticsEvent --> EventType : eventType

    %% Bannières d'information
    InfoBanner --> InfoBannerType : type
    InfoBanner --> InfoBannerAudience : audience
    User "0..1" o-- "0..*" InfoBanner : createdBy
