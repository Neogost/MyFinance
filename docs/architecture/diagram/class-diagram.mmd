classDiagram

    %% ══════════════════════════════════════════════════════════════
    %% MyFinance — Diagramme de classes complet
    %% Mis à jour à partir des entités JPA et DTOs réels (domain/*.java)
    %% ══════════════════════════════════════════════════════════════

    %% ── Utilisateurs & Sécurité ────────────────────────────────

    class User {
        <<entity>>
        +Long id
        +String firstName
        +String lastName
        +LocalDate birthDate
        +String login
        +String password
        +RoleEnum role
        +Float fiscalParts
        +Boolean useFlatRateDeduction
        +Float customProfessionalDeduction
        +Integer realExpensesTransportKm
        +Integer realExpensesTransportCv
        +Boolean realExpensesTransportElectric
        +Float realExpensesPublicTransport
        +Float realExpensesMeals
        +Float realExpensesClothing
        +Float realExpensesTraining
        +Float realExpensesEquipment
        +Float realExpensesPhone
        +Float realExpensesDoubleResidence
        +Float realExpensesOther
        +Integer realExpensesTeleworkDays
        +Float realExpensesTeleworkEmployerDaily
        +String birthPlace
        +String birthPostalCode
        +String jobTitle
        +SafetyNetMode safetyNetMode
        +Double safetyNetMonths
        +Double safetyNetAmount
        +Boolean analyticsOptOut
        +FamilyGroup familyGroup
    }

    class RoleEnum {
        <<enumeration>>
        USER
        ADMIN
    }

    class SafetyNetMode {
        <<enumeration>>
        MONTHS_EXPENSES
        MONTHS_SALARY
        FIXED_AMOUNT
    }

    class FamilyGroup {
        <<entity>>
        +Long id
        +String name
        +User owner
        +LocalDateTime createdAt
    }

    class FamilyGroupInvitation {
        <<entity>>
        +Long id
        +FamilyGroup group
        +User invitedUser
        +InvitationStatus status
        +LocalDateTime createdAt
        +LocalDateTime respondedAt
    }

    class InvitationStatus {
        <<enumeration>>
        PENDING
        ACCEPTED
        REFUSED
    }

    class LoginEvent {
        <<entity>>
        +Long id
        +String login
        +LoginEventType eventType
        +String ipAddress
        +String userAgent
        +Integer failureCount
        +LocalDateTime timestamp
    }

    class LoginEventType {
        <<enumeration>>
        SUCCESS
        FAILURE
        BLOCKED
    }

    class UserRegistrationRequest {
        <<entity>>
        +Long id
        +String login
        +String firstName
        +String lastName
        +String hashedPassword
        +RegistrationStatus status
        +LocalDateTime createdAt
        +LocalDateTime reviewedAt
        +String reviewedBy
    }

    class RegistrationStatus {
        <<enumeration>>
        PENDING
        APPROVED
        REJECTED
    }

    %% ── Revenus salariaux ──────────────────────────────────────

    class SalaryContract {
        <<entity>>
        +Long id
        +User user
        +String companyName
        +ContractTypeEnum contractType
        +PublicSubTypeEnum publicSubType
        +LocalDate startDate
        +LocalDate endDate
        +Float annualGrossSalary
        +Integer indiceMajore
        +Integer paidMonthsPerYear
        +Float weeklyHours
        +Float partTimePercentage
        +Float mealVoucherAmount
        +Float mealVoucherEmployeeRate
        +Boolean isCadre
        +Float employeePrevoyanceRate
    }

    class ContractTypeEnum {
        <<enumeration>>
        PRIVATE
        PUBLIC
    }

    class PublicSubTypeEnum {
        <<enumeration>>
        TITULAIRE
        CONTRACTUEL
    }

    class SalaryRevision {
        <<entity>>
        +Long id
        +SalaryContract contract
        +LocalDate effectiveDate
        +Float annualGrossSalary
        +Integer indiceMajore
        +String label
    }

    class MonthlyPaySlip {
        <<entity>>
        +Long id
        +SalaryContract contract
        +LocalDate period
        +Float grossSalary
        +Float taxableNetSalary
        +Float netSalary
        +Float incomeTaxWithholding
    }

    class ContractBonus {
        <<entity>>
        +Long id
        +SalaryContract contract
        +String label
        +Float grossAmount
        +BonusTypeEnum type
        +LocalDate paymentDate
        +Integer paymentMonth
    }

    class ContractBenefit {
        <<entity>>
        +Long id
        +SalaryContract contract
        +String label
        +Float monthlyAmount
    }

    class ContractOnCall {
        <<entity>>
        +Long id
        +SalaryContract contract
        +Float weeklyFlatRate
        +Integer estimatedWeeksPerYear
    }

    class BonusTypeEnum {
        <<enumeration>>
        EXCEPTIONNELLE
        ANNUELLE
    }

    class SalaryContractDto {
        <<record — calculé, non persisté>>
        +Float annualSuperGross
        +Float monthlySuperGross
        +Float dailySuperGross
        +Float hourlySuperGross
        +Float annualGrossSalary
        +Float monthlyGrossSalary
        +Float dailyGrossSalary
        +Float hourlyGrossSalary
        +Float annualNetImposable
        +Float monthlyNetImposable
        +Float dailyNetImposable
        +Float hourlyNetImposable
        +Float annualNetAfterTax
        +Float monthlyNetAfterTax
        +Float dailyNetAfterTax
        +Float hourlyNetAfterTax
        +Float monthlyEstimatedTax
        +Float monthlyBenefits
        +Float baseGrossSalary
        +Float annualWorkingHours
        +Float employeeMonthlyMealVoucherCost
        +Float employerMonthlyMealVoucherCost
    }

    %% ── Revenus complémentaires ────────────────────────────────

    class OtherIncome {
