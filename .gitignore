*.db
*.db-shm
*.db-wal
*.sqlite

# =============================================================
#  PROFILES DE CONFIGURATION SENSIBLES
# =============================================================
application.properties          # configuration Spring Boot (tous profils)
application-dev.properties      # configuration locale de développement
application-prod.properties     # contient l'IP du NAS, chemins, etc.
application-docker.properties   # contient la config Docker (CORS, chemins)
application-secrets.properties

