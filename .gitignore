# =============================================================
#  JAVA / MAVEN
# =============================================================
target/
*.class
*.jar
*.war
*.ear
*.log
.mvn/wrapper/maven-wrapper.jar

# =============================================================
#  INTELLIJ / VSCODE
# =============================================================
.idea/
*.iml
*.iws
.vscode/
!.vscode/extensions.json        # garder les recommandations de plugins

# =============================================================
#  DÉPLOIEMENT — contient IP, chemins NAS, credentials
# =============================================================
deploy.sh
scripts/deploy.sh
docker-compose.yml

# =============================================================
#  DONNÉES SENSIBLES — ne jamais committer !
# =============================================================
data/                           # fichier SQLite
logs/
.env                            # variables d'environnement réelles
*.db
*.db-shm
*.db-wal
*.sqlite

# =============================================================
#  PROFILES DE CONFIGURATION SENSIBLES
# =============================================================
# Les commentaires en fin de ligne ne sont pas supportés par gitignore — lignes séparées obligatoires
application.properties
application-dev.properties
application-prod.properties
application-docker.properties
application-secrets.properties
# Fichiers de config de test (peuvent contenir des mots de passe d'intégration)
application-integration.properties

# =============================================================
#  NODE / REACT (frontend)
# =============================================================
node_modules/
dist/
build/
coverage/
.npm
.eslintcache
*.tsbuildinfo

# =============================================================
#  BUILD FRONTEND (intégré au JAR Spring Boot en prod)
# =============================================================
backend/src/main/resources/static/

# =============================================================
#  AUDITS DE SÉCURITÉ — contiennent des détails d'exploitation
# =============================================================
SECURITY-AUDIT*.md
security-audit*.md

# =============================================================
#  OS
# =============================================================
.DS_Store
Thumbs.db
desktop.ini

# =============================================================
#  CLAUDE CODE — config locale (settings, skills, transcripts)
# =============================================================
.claude/